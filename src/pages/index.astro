---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import {loadPapers,groups} from '../../scripts/catalog.mjs';
const papers=loadPapers(),base=import.meta.env.BASE_URL.replace(/\/$/,'');
const years=[...new Set(papers.map(p=>p.published.slice(0,4)))].sort();
---
<Layout>
<section class="la-hero"><div><div class="la-eyebrow"><span class="la-dot"></span>AHA LOOPED TRANSFORMER</div><h1>Think deeper.<br/><em>Find your Aha.</em></h1><p>An open atlas of recurrent computation,<br/>adaptive depth, and latent reasoning.</p></div><div class="la-feature"><div class="la-feature-top"><span>RECURRENT COMPUTATION</span><span>Shared weights · More depth</span></div><div class="la-art"><canvas id="la-orbit" role="img" aria-label="Conceptual animation of particles revisiting shared computation; not measured model data."></canvas><div class="la-center"><span>REPEAT. REFINE.</span></div><span class="la-art-label">One more pass. A new perspective.</span><button type="button" id="la-motion-toggle" aria-pressed="false">Pause motion</button></div><div class="la-feature-bottom"><span>Explore recurrent architectures</span><a class="button" href={`${base}/papers/huginn/`}>Inside Huginn →</a></div></div></section>
<section id="la-explore"><div class="la-heading"><h2>The collection</h2><span class="la-quiet" id="la-results" aria-live="polite">{papers.length} works</span></div><div class="la-tools"><input type="search" id="la-search" aria-label="Search papers" placeholder="Search a paper or idea…"/><button type="button" data-filter="all" aria-pressed="true">All works</button><button type="button" data-filter="adaptive" aria-pressed="false">Adaptive depth</button><button type="button" data-filter="core" aria-pressed="false">Core recurrence</button><button type="button" data-filter="full" aria-pressed="false">Full stack</button></div><div id="la-cards" class="la-grid">{papers.map(p=><Card paper={p}/>)}</div><p id="la-empty" hidden>No works match this search. Try another idea or choose All works.</p></section>
<section id="la-timeline" hidden><div class="la-heading"><h2>A timeline of ideas</h2><span class="la-quiet">First publication · earliest to latest</span></div>{years.map(year=><div class="la-year"><h2>{year}</h2><div class="la-timeline-items">{papers.filter(p=>p.published.startsWith(year)).reverse().map(p=><a class="la-time-item" href={`${base}/papers/${p.id}/`}><span>{p.name}</span><span class="la-quiet">{p.published.slice(5)} · {groups[p.group]}</span></a>)}</div></div>)}</section>
<section id="la-compare" hidden><div class="la-heading"><h2>Methods, side by side</h2><button type="button" id="la-clear">Clear selection</button></div><p id="la-comparison-help">Select up to 3 works in Explore to compare their architecture and depth control.</p><div id="la-comparison" class="la-grid">{papers.map(p=><article data-comparison={p.id} hidden><h3><a href={`${base}/papers/${p.id}/`}>{p.name}</a></h3><dl><dt>Recurrence</dt><dd>{p.diagram}</dd></dl><dl><dt>Depth control</dt><dd>{p.depth}</dd></dl><dl><dt>KV / state strategy</dt><dd>{p.kv}</dd></dl><dl><dt>Reading note</dt><dd>{p.notes}</dd></dl><a href={`https://arxiv.org/abs/${p.arxiv}`}>Paper ↗</a><button type="button" data-remove={p.id}>Remove {p.name}</button></article>)}</div></section>
<div class="la-selection" id="la-selection" hidden><span id="la-selected-text" aria-live="polite"></span><a href="?view=compare" id="la-open-compare">Compare selected →</a></div>
<noscript><p>All papers are listed above. Enable JavaScript for search, comparison, and the animated illustration.</p></noscript>
<script>import '../scripts/collection.js'; import '../scripts/motion.js';</script>
</Layout>
