---
import {groups} from '../../scripts/catalog.mjs';
const {paper:p}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<article data-paper={p.id} data-group={p.group} data-search={`${p.name} ${p.title} ${p.summary} ${p.authors.join(' ')} ${groups[p.group]}`.toLowerCase()}>
<div class="la-meta"><time datetime={p.published}>{p.published.slice(0,4)}</time><span>Research paper</span></div><h3><a href={`${base}/papers/${p.id}/`}>{p.name}</a></h3><p>{p.summary}</p><div class="la-schema" aria-label="Simplified recurrence schematic">{p.diagram}</div><div class="la-tag">{groups[p.group]}</div><div class="la-foot"><a href={`${base}/papers/${p.id}/`}>View method →</a><label><input type="checkbox" data-compare={p.id} aria-label={`Compare ${p.name}`}/>Compare</label></div></article>
